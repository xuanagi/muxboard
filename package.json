{
    "name": "muxboard",
    "version": "0.1.0",
    "private": true,
    "author": "Muxboard Contributors",
    "license": "MIT",
    "description": "Portable multi-server tmux workspace for SSH-driven development",
    "main": "out/main/index.js",
    "type": "module",
    "scripts": {
        "postinstall": "node node_modules/electron/install.js",
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "package": "bun run build && electron-builder --dir",
        "dist": "bun run build && electron-builder",
        "dist:win": "bun run build && electron-builder --win nsis",
        "dist:linux": "bun run build && electron-builder --linux AppImage"
    },
    "dependencies": {
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "ssh2": "^1.17.0",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@types/bun": "^1.3.5",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/ssh2": "^1.15.5",
        "@vitejs/plugin-react": "^5.1.2",
        "electron": "^39.2.7",
        "electron-builder": "^26.0.12",
        "electron-vite": "^4.0.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.0"
    },
    "build": {
        "appId": "com.muxboard.desktop",
        "productName": "Muxboard",
        "directories": {
            "output": "release"
        },
        "files": [
            "out/**/*",
            "package.json"
        ],
        "icon": "assets/muxboard.ico",
        "extraResources": [
            {
                "from": "assets/muxboard.ico",
                "to": "assets/muxboard.ico"
            }
        ],
        "asar": false,
        "win": {
            "icon": "assets/muxboard.ico",
            "target": ["nsis"],
            "artifactName": "Muxboard-${version}-${arch}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "linux": {
            "target": ["AppImage"],
            "category": "Development"
        },
        "mac": {
            "target": ["dmg"],
            "category": "public.app-category.developer-tools"
        }
    }
}
